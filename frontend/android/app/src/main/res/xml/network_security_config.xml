<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds block cleartext HTTP by default, which is correct: the
  prototype backend is plain HTTP, so without this every request from a
  release APK fails silently.

  This permits cleartext for named development hosts ONLY and leaves the
  default denial in place for everything else, rather than switching cleartext
  on app-wide the way the debug manifest does. Anything not listed here still
  has to be HTTPS.

  When the backend gets a real host and certificate, delete the domain-config
  block below and this file stops mattering.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- Tailnet address of the development machine (taylorrozies). -->
        <domain includeSubdomains="false">100.68.162.111</domain>
        <!-- Its MagicDNS name, which survives a tailnet IP change. -->
        <domain includeSubdomains="true">taylorrozies.ts.net</domain>
        <!-- Android emulator loopback to the host machine. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
